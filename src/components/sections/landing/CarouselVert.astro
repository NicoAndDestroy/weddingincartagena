---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const imagesVertical = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/values/vertical/values_*.{jpg,webp}",
  { eager: true }
);

const imageArrayVertical = Object.values(imagesVertical).map((image) => ({
  src: image.default,
  mode: "vertical",
}));

const alt = "Bodas en Cartagena";
---

<section class="my-20">
  <div id="wedding-slider-vert" class="relative">
    <div class="swiper-wrapper">
      {
        imageArrayVertical.map((image) => (
          <div class="swiper-slide">
            <Image
              class="w-full md:h-[700px] object-cover"
              src={image.src}
              alt={alt}
            />
          </div>
        ))
      }
    </div>

    <div class="swiper-pagination"></div>

    <button
      type="button"
      class="swiper-button-prev"
      aria-label="Previous slide"
      aria-controls="wedding-slider-vert"
    ></button>

    <button
      type="button"
      class="swiper-button-next"
      aria-label="Next slide"
      aria-controls="wedding-slider-vert"
    ></button>

    <div class="swiper-scrollbar"></div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination, Autoplay, Scrollbar } from "swiper/modules";

  import "swiper/css";
  import "swiper/css/navigation";
  import "swiper/css/pagination";
  import "swiper/css/scrollbar";

  const selector = document.getElementById("wedding-slider-vert");

  if (selector) {
    new Swiper(selector, {
      modules: [Navigation, Pagination, Autoplay, Scrollbar],

      autoplay: {
        delay: 5000,
      },

      breakpoints: {
        320: {
          slidesPerView: 1,
          spaceBetween: 30,
        },
        640: {
          slidesPerView: 3,
          spaceBetween: 40,
        },
      },

      loop: true,

      scrollbar: {
        el: ".swiper-scrollbar",
      },

      navigation: {
        prevEl: ".swiper-button-prev",
        nextEl: ".swiper-button-next",
      },
    });
  }
</script>